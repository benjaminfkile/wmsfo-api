<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- SixLabors.ImageSharp 3.1.12 (src/Wmsfo.Api): the six advisories of 2026-10-07 are
         fixed in ImageSharp 4.x only (the sixth names a 3.2.0 that was never published),
         and 4.x needs a Six Labors license file at build time; 3.1.12 is the last 3.x
         release. None of the six code paths is reachable: VariantDeriver.RasterDecoder
         admits the png, jpeg, webp, and gif decoders only, so the TIFF decoder (the tiled
         fax path of the sixth included) and encoders never run; the API never calls
         HistogramEqualization; it never reads an ICC profile's tags. The audit fires in
         every project that references the API, so the suppression lives here. The sixth
         reached the NuGet audit feed on 2026-10-27 and failed that day's deploys. Revisit
         at the next upgrade. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
  </ItemGroup>
</Project>
