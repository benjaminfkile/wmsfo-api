{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wmsfo.dev/schema/sections/route_preview.schema.json",
  "title": "route_preview section data",
  "type": "object",
  "properties": {
    "heading": { "$ref": "https://wmsfo.dev/schema/primitives.schema.json#/$defs/InlineNullable" },
    "style": { "enum": ["image", "viewer", "map"] },
    "disclaimer": { "$ref": "https://wmsfo.dev/schema/primitives.schema.json#/$defs/InlineNullable" },
    "emptyText": { "$ref": "https://wmsfo.dev/schema/primitives.schema.json#/$defs/Inline" },
    "controls": {
      "type": "object",
      "properties": {
        "fullscreen": { "type": "boolean" },
        "terrain": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "landmarks": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[\\s\\S]+$" },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lng": { "type": "number", "minimum": -180, "maximum": 180 }
        },
        "required": ["name", "lat", "lng"],
        "additionalProperties": false
      }
    },
    "pois": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[a-z0-9_]+$" }
        }
      },
      "required": ["kinds"],
      "additionalProperties": false
    }
  },
  "required": ["heading", "style", "disclaimer", "emptyText"],
  "additionalProperties": false
}
